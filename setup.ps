# 1. Define Extension IDs
$uiVisionId = "gcbalfbdmfieckjlnblleoemohcganoc"
$emailOnDeckId = "mkpcaklladfpajiaikehdinfaabmnajh"
$adblockPlusId = "ddkjiahejlhfcafbddmgiahcphecmpfh"
$updateUrl = "https://clients2.google.com/service/update2/crx"

Write-Host "--- Task 1: Registering Chrome Extensions (Including Adblock Plus) ---" -ForegroundColor Cyan
$registryPaths = @(
    "HKLM:\SOFTWARE\Wow6432Node\Google\Chrome\Extensions",
    "HKLM:\SOFTWARE\Google\Chrome\Extensions"
)

$extensionIds = @($uiVisionId, $emailOnDeckId, $adblockPlusId)

foreach ($path in $registryPaths) {
    if (!(Test-Path $path)) { New-Item -Path $path -Force }
    
    foreach ($id in $extensionIds) {
        $extPath = "$path\$id"
        if (!(Test-Path $extPath)) { New-Item -Path $extPath -Force }
        New-ItemProperty -Path $extPath -Name "update_url" -Value $updateUrl -PropertyType String -Force
    }
}

Write-Host "--- Task 2: Downloading scale.json ---" -ForegroundColor Cyan
$jsonUrl = "https://matthijs12310.github.io/scale.json"
$jsonPath = "$env:USERPROFILE\Downloads\scale.json"
# Added ErrorAction SilentlyContinue to handle potential network hiccups
Invoke-WebRequest -Uri $jsonUrl -OutFile $jsonPath -ErrorAction SilentlyContinue
Write-Host "Saved to: $jsonPath"


Write-Host "--- Setup Complete! ---" -ForegroundColor Green
Write-Host "Please RESTART Chrome. You will need to click 'Enable' on the extension prompts."