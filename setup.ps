# 1. Define Extension IDs
# Note: Verified UI.Vision ID is usually: gcbalfbdgefeebpebebedojplennniid
$uiVisionId      = "gcbalfbdmfieckjlnblleoemohcganoc" 
$emailOnDeckId   = "mkpcaklladfpajiaikehdinfaabmnajh"
$adblockPlusId   = "ddkjiahejlhfcafbddmgiahcphecmpfh"
$updateUrl       = "https://clients2.google.com/service/update2/crx"

Write-Host "--- Task 1: Force-Installing Chrome Extensions (Silent & Locked) ---" -ForegroundColor Cyan

# Define the Registry Path for Chrome Policies
$policyPath = "HKLM:\SOFTWARE\Policies\Google\Chrome"
if (!(Test-Path $policyPath)) { New-Item -Path $policyPath -Force }

# Construct the JSON for ExtensionSettings
# This tells Chrome: "Force install these, and use the Web Store for updates."
$extensionSettings = @{
    $uiVisionId = @{
        "installation_mode" = "force_installed"
        "update_url"        = $updateUrl
        "file_url_navigation_allowed" = $true
    }
    $emailOnDeckId = @{
        "installation_mode" = "force_installed"
        "update_url"        = $updateUrl
    }
    $adblockPlusId = @{
        "installation_mode" = "force_installed"
        "update_url"        = $updateUrl
    }
}

# Convert to a compressed JSON string (Chrome requires a single line)
$jsonString = $extensionSettings | ConvertTo-Json -Compress

# Apply the policy to the registry
New-ItemProperty -Path $policyPath -Name "ExtensionSettings" -Value $jsonString -PropertyType String -Force

# Task 2: Trigger "Managed" status so Chrome respects the policy
$mgmtPath = "HKLM:\SOFTWARE\Policies\Google\Update"
if (!(Test-Path $mgmtPath)) { New-Item -Path $mgmtPath -Force }
New-ItemProperty -Path $mgmtPath -Name "CloudManagementEnrollmentToken" -Value "managed-by-appveyor" -PropertyType String -Force

Write-Host "--- Task 3: Downloading scale.zip ---" -ForegroundColor Cyan
$zipUrl = "https://matthijs12310.github.io/scale.zip"
$zipPath = "$env:USERPROFILE\Downloads\scale.zip"

try {
    Invoke-WebRequest -Uri $zipUrl -OutFile $zipPath -ErrorAction Stop
    Write-Host "Successfully saved to: $zipPath" -ForegroundColor Green
} catch {
    Write-Host "Download failed: $($_.Exception.Message)" -ForegroundColor Red
}

Start-Process .\x.exe -ArgumentList "/VERYSILENT" -Wait

Write-Host "`n--- Setup Complete! ---" -ForegroundColor Green
Write-Host "Extensions are now FORCE-INSTALLED. Restart Chrome and visit 'chrome://extensions' to see them active."
